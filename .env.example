# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Режим: demo — всё на демо-данных, Tulpar не нужен (по умолчанию).
#        tulpar — только ЛОКАЛЬНЫЙ стенд Tulpar; прод запрещён проверкой в config.py.
TULPAR_MODE=demo
TULPAR_API_URL=
TULPAR_JWT_SECRET=
TULPAR_DATABASE_URL=

# Где сервис хранит своё состояние (очередь, чекпоинты графа, индекс RAG). На Railway — путь volume, например /data
AI_DATA_DIR=./data

# Секреты этого сервиса (не Tulpar!). На Railway задайте длинные случайные строки.
JWT_SECRET=dev-only-tulpar-ai-coach-change-me-0123456789abcdef
INTERNAL_SECRET=dev-only-internal-secret-change-me
ALLOW_DEMO_LOGIN=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8089

# LLM. Ollama Cloud — основной; лучше ОТДЕЛЬНЫЙ ключ, не тот, что в проде Tulpar.
OLLAMA_API_KEY=
# Groq — распознавание голоса и запасная модель. Бесплатный ключ: console.groq.com
GROQ_API_KEY=
# Цепочки моделей «провайдер:модель» по ролям; первая доступная отвечает, остальные — резерв.
ROUTE_MODELS=ollama:minimax-m3,groq:openai/gpt-oss-20b
TEXT_MODELS=ollama:minimax-m3,groq:openai/gpt-oss-120b
VISION_MODELS=ollama:kimi-k2.7-code,ollama:kimi-k2.6,ollama:minimax-m3
JUDGE_MODELS=ollama:qwen3.5:397b,groq:openai/gpt-oss-120b

# RAG: эмбеддинги и реранкер Jina (бесплатный ключ: jina.ai). Без ключа работает локальный запасной вариант.
JINA_API_KEY=
RAG_EMBEDDER=auto

# Трейсинг LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tulpar-ai-coach

# Telegram-бот этого проекта (не бот Tulpar). Числовые ID тренеров через запятую — узнать у @userinfobot.
TELEGRAM_BOT_TOKEN=
TRAINER_TELEGRAM_IDS=

# Для MCP-сервера в Claude Desktop: адрес этого сервиса
SERVICE_URL=http://localhost:8089
