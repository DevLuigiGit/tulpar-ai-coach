{
  "mcpServers": {
    "tulpar-mcp": {
      "command": "<PATH_TO_REPO>/.venv/bin/python",
      "args": ["-m", "tulpar_ai.mcp_server"],
      "cwd": "<PATH_TO_REPO>",
      "env": {
        "SERVICE_URL": "https://coach-production-18ca.up.railway.app",
        "INTERNAL_SECRET": "<INTERNAL_SECRET из .env>",
        "TULPAR_TRAINER_ID": ""
      }
    }
  }
}
